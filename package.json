{
  "name": "ict-backend",
  "version": "1.0.0",
  "description": "ICT Project - Professional SAP CAP Backend",
  "main": "srv/index.js",
  "private": true,
  "scripts": {
    "start": "cds run",
    "dev": "cds watch",
    "build": "cds build --production",
    "test": "jest --coverage",
    "lint": "eslint 'db/**/*.js' 'srv/**/*.js' --fix",
    "deploy": "cds deploy"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.1",
    "@ai-sdk/google": "^4.0.2",
    "@ai-sdk/openai": "^4.0.2",
    "@cap-js/postgres": "^1.14.2",
    "@sap-cloud-sdk/connectivity": "^4.7.0",
    "@sap-cloud-sdk/http-client": "^4.7.0",
    "@sap/cds": "^8",
    "@sap/cds-dk": "^8",
    "@sap/xssec": "^4.8.0",
    "ai": "^7.0.4",
    "cds-swagger-ui-express": "^0.11.0",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "passport": "^0.7.0"
  },
  "devDependencies": {
    "@cap-js/sqlite": "^1.11.1",
    "@eslint/js": "^9.9.0",
    "@sap/cds-dk": "^8.5.0",
    "cds-swagger-ui-express": "^0.11.0",
    "eslint": "^9.9.0",
    "jest": "^29.7.0",
    "sqlite3": "^6.0.1"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "sap",
    "cap",
    "enterprise",
    "backend"
  ],
  "author": "ICT Project Team",
  "license": "Apache-2.0",
  "cds": {
    "requires": {
      "db": {
        "kind": "sqlite",
        "credentials": {
          "database": "db.sqlite"
        }
      },
      "ICT_AI_JOB": {
        "kind": "rest",
        "credentials": {
          "url": "http://localhost:4000/mock-jobscheduler"
        }
      },
      "[production]": {
        "db": {
          "kind": "postgres"
        },
        "ICT_AI_JOB": {
          "kind": "rest",
          "credentials": {
            "destination": "ICT_AI_JOB"
          }
        }
      }
    }
  }
}
