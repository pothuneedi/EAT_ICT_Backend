{
  "xsappname": "ict-backend",
  "tenant-mode": "dedicated",
  "description": "Security profile of ict-backend application",
  "scopes": [
    {
      "name": "uaa.user",
      "description": "UAA"
    },
    {
      "name": "$XSAPPNAME.JobScheduler",
      "description": "JobScheduler",
      "grant-as-authority-to-apps": ["$XSSERVICENAME(BTP_JOBS)"]
    }
  ],
  "authorities": ["$ACCEPT_GRANTED_AUTHORITIES"],
  "role-templates": [
    {
      "name": "Token_Exchange",
      "description": "UAA",
      "scope-references": [
        "uaa.user"
      ]
    },
    {
      "name": "JobScheduler",
      "description": "Job Scheduler",
      "scope-references": ["$XSAPPNAME.JobScheduler"]
    }
  ]
}